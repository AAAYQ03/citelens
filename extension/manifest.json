{
  "manifest_version": 3,
  "name": "CiteLens — verify AI citations",
  "version": "0.2.0",
  "description": "Split-screen source verification on top of ChatGPT: open any cited source beside the answer, with the relevant passage highlighted.",
  "permissions": ["sidePanel", "storage", "tabs", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel/panel.html" },
  "action": { "default_title": "Open CiteLens panel" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/chatgpt.js"],
      "css": ["content/chatgpt.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/highlighter.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
